// Monsters (board rows E10, G8, C4). All our own designs. REF R41: a zombie-like walker (shambler).
// REF R42: a giant spider (cave_spider) and a ghost-like figure (wisp). REF R43: spiders are marked `spider`
// and become beetles in the spider-free mode.
// speed: energy per tick; 12 acts once a tick, 18 three times in two ticks, 8 twice in three ticks.
// ac is ascending (higher is harder to hit); to_hit is added to a d20 against the party's AC.
{
    "rat": (name: "cellar rat", hp: "1d6", ac: 11, to_hit: 1, damage: "1d3", speed: 18, sight: 6, xp: 3,
        depth: (1, 3), weight: 10, model: "rat"),
    "shambler": (name: "shambler", hp: "2d8+2", ac: 8, to_hit: 2, damage: "1d6+1", speed: 9, sight: 7, xp: 8,
        depth: (1, 5), weight: 12, undead: true, model: "shambler"),
    "cave_spider": (name: "cave spider", hp: "3d8", ac: 12, to_hit: 3, damage: "1d8", speed: 16, sight: 8, xp: 14,
        depth: (2, 7), weight: 7, climbs: true, spider: true, on_hit: Some(Poison), model: "spider"),
    "beetle": (name: "rock beetle", hp: "3d8+2", ac: 13, to_hit: 3, damage: "1d8", speed: 12, sight: 6, xp: 14,
        depth: (2, 7), weight: 0, climbs: true, special: true, model: "beetle"),
    "ooze": (name: "grey ooze", hp: "4d8", ac: 6, to_hit: 2, damage: "2d4", speed: 7, sight: 5, xp: 12,
        depth: (2, 7), weight: 6, model: "ooze"),
    "wisp": (name: "tomb wisp", hp: "2d10", ac: 14, to_hit: 4, damage: "1d6", speed: 14, sight: 9, xp: 20,
        depth: (3, 8), weight: 6, flies: true, undead: true, on_hit: Some(DrainMana), model: "wisp"),
    "bone_archer": (name: "bone archer", hp: "3d8", ac: 12, to_hit: 4, damage: "1d8", speed: 12, sight: 10, xp: 22,
        depth: (4, 8), weight: 6, undead: true, ranged: Some(6), model: "archer"),
    "ghoul": (name: "ghoul", hp: "4d8+4", ac: 13, to_hit: 5, damage: "1d10+1", speed: 13, sight: 8, xp: 30,
        depth: (5, 8), weight: 6, undead: true, on_hit: Some(Poison), model: "ghoul"),
    "deep_knight": (name: "hollow knight", hp: "5d10", ac: 15, to_hit: 6, damage: "2d6+2", speed: 11, sight: 8, xp: 55,
        depth: (6, 8), weight: 4, undead: true, model: "knight"),
    "mimic": (name: "mimic", hp: "5d8", ac: 13, to_hit: 5, damage: "2d6", speed: 10, sight: 3, xp: 35,
        depth: (2, 8), weight: 0, special: true, model: "mimic"),
    "warden": (name: "Warden of the Deep", hp: "10d10+10", ac: 16, to_hit: 7, damage: "2d8+3", speed: 12, sight: 10, xp: 300,
        depth: (8, 8), weight: 0, undead: true, special: true, model: "warden"),
}
