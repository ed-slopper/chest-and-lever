// Hand-built rooms, "made with procedural generation in mind" (R45); board row C2. All ours.
// Layers go bottom to top; layer 0 is the floor under the party's feet. Every prefab sits inside a room with a
// ring of free floor around it, so none can block the way. Legend: see `Prefab` in lac-rs/sim/src/content.rs.
[
    (
        name: "crypt_hall", depth: (1, 6), weight: 10,
        layers: [
            ["=====", "=====", "=====", "=====", "====="],
            ["T.T.T", ".....", "T.g.T", ".....", "T.T.T"],
        ],
    ),
    (
        name: "shrine", depth: (1, 8), weight: 6,
        layers: [
            ["=====", "=====", "=====", "=====", "====="],
            ["#...#", ".....", "..F..", ".....", "#...#"],
            ["#...#", ".....", ".....", ".....", "#...#"],
            ["#...#", ".....", ".....", ".....", "#...#"],
        ],
    ),
    (
        name: "lever_vault", depth: (2, 8), weight: 8,
        layers: [
            ["=======", "=======", "=======", "=======", "======="],
            ["#######", "#.C.C.#", "#.....#", "L##P###", "......."],
            ["#######", "#.....#", "#.....#", "#######", "......."],
            ["#######", "#######", "#######", "#######", "......."],
        ],
    ),
    (
        name: "spike_hall", depth: (1, 8), weight: 6,
        layers: [
            ["=======", "==^^^==", "==^^^==", "==^^^==", "======="],
            [".......", ".......", ".....gi", ".......", "......."],
        ],
    ),
    (
        name: "ossuary", depth: (4, 7), weight: 8,
        layers: [
            ["=====", "=====", "=====", "=====", "====="],
            ["T.T.T", "..G..", "T.i.T", ".....", "T.T.T"],
        ],
    ),
    (
        name: "lava_island", depth: (5, 8), weight: 6,
        layers: [
            ["lllllll", "ll===ll", "ll===ll", "lllBlll", "lllBlll", "======="],
            [".......", "...C...", ".......", ".......", ".......", "..L...."],
        ],
    ),
    (
        name: "warden_vault", depth: (8, 8), weight: 0, special: true,
        layers: [
            ["=======", "=======", "=======", "=======", "=======", "=======", "======="],
            ["#######", "#.....#", "#..X..#", "#.....#", "#..W..#", "#.....#", "###D###"],
            ["#######", "#.....#", "t.....t", "#.....#", "#.....#", "#.....#", "#######"],
            ["#######", "#.....#", "#.....#", "#.....#", "#.....#", "#.....#", "#######"],
            ["#######", "#######", "#######", "#######", "#######", "#######", "#######"],
        ],
    ),
]
