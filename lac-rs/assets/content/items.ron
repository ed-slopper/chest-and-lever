// Items (board rows E10, G5, C5). Ours: names, numbers and effects. R12 asks for cursed items and broken
// combinations; R74 (how curses work) is a gap, designed in lac-rs/sim/src/item.rs.
// depth: (first, last) depth it is found at. weight: how often against its category. cursed: extra percent.
{
    // ---- weapons
    "dagger": (name: "dagger", kind: Weapon(damage: "1d4", stat: Dex), depth: (1, 4), weight: 10, icon: "dagger"),
    "short_sword": (name: "short sword", kind: Weapon(damage: "1d6", stat: Dex), depth: (1, 6), weight: 10, icon: "sword"),
    "longsword": (name: "longsword", kind: Weapon(damage: "1d8", stat: Str), depth: (1, 8), weight: 8, icon: "sword"),
